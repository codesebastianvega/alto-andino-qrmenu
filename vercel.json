{
  "rewrites": [
    {
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(whatsapp|facebookexternalhit|twitterbot|telegrambot|linkedinbot|slackbot|discordbot).*"
        }
      ],
      "source": "/:slug*",
      "destination": "/api/og?slug=:slug*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
