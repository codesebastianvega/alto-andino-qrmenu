{
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "/api/:match*"
    },
    {
      "source": "/:slug*/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([wW]hats[aA]pp|[fF]acebookexternalhit|[fF]acebot|[tT]witterbot|[tT]elegram[bB]ot|[lL]inked[iI]n[bB]ot|[sS]lackbot|[dD]iscordbot).*"
        }
      ],
      "destination": "/api/og?slug=:slug*"
    },
    {
      "source": "/:slug*",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([wW]hats[aA]pp|[fF]acebookexternalhit|[fF]acebot|[tT]witterbot|[tT]elegram[bB]ot|[lL]inked[iI]n[bB]ot|[sS]lackbot|[dD]iscordbot).*"
        }
      ],
      "destination": "/api/og?slug=:slug*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
